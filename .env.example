# Anthropic API key — required for AI extraction (never commit the real value)
ANTHROPIC_API_KEY=sk-ant-...

# Upstash Redis — required for per-IP rate limiting on /api/analyze
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# Set to "false" to skip Playwright headless rendering (faster local tests, no Tier 2 scraping)
ENABLE_TIER2_RENDER=true

# Set to "true" to load a hardcoded ExtractionResult stub in /review (walking-skeleton dev mode)
NEXT_PUBLIC_STUB=false
